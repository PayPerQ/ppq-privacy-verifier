{
  "name": "ppq-private-mode",
  "version": "0.7.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "description": "Verify PPQ.AI's privacy yourself. A local proxy that checks the attestation of the enclave your request is headed for and encrypts it to that enclave before it leaves your machine: PPQ's Nitro enclave for frontier models, Tinfoil's for private/* models. Standalone or OpenClaw plugin.",
  "license": "MIT",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "bin": {
    "ppq-private-proxy": "./dist/bin/server.js"
  },
  "scripts": {
    "build": "tsc && node --input-type=module -e \"import{cpSync}from'node:fs';cpSync('lib/nitro','dist/lib/nitro',{recursive:true})\"",
    "start": "npx tsx bin/server.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "skills",
    "openclaw.plugin.json",
    "README.md"
  ],
  "dependencies": {
    "@peculiar/x509": "^1.14.3",
    "cbor-x": "^1.6.4",
    "ehbp": "^0.2.0",
    "tinfoil": "^1.1.11",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.1.0"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "repository": "github:PayPerQ/ppq-privacy-verifier"
}
